  "tipo": "módulo",
  "roteiros": {
    "desenvolvedor": "servidor tsx.ts",
    "construir": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
